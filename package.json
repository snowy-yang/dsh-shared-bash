{
  "name": "dsh-shared-bash",
  "version": "0.2.0",
  "description": "tmux-like shared persistent bash sessions for DeepSeek Harness: every agent in a profile can open, drive and read the same shells, keeping cwd, variables and background state between calls.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "index.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "bash",
    "terminal",
    "tmux",
    "shell",
    "msys2",
    "windows"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.1-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test test/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowy-yang/dsh-shared-bash.git"
  },
  "bugs": {
    "url": "https://github.com/snowy-yang/dsh-shared-bash/issues"
  },
  "homepage": "https://github.com/snowy-yang/dsh-shared-bash#readme"
}
